<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.GiragNFC" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/girag_navy</item>
        <item name="colorPrimaryDark">@color/girag_navy</item>
        <item name="colorAccent">@color/girag_orange</item>
        <item name="android:windowBackground">@color/girag_navy</item>
        <!-- Evita que Android 15 dibuje el contenido bajo la barra de estado -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>
</resources>
